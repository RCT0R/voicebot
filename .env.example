# =============================================================================
# LiveKit (required)
# Create a project at https://cloud.livekit.io and copy these from Settings.
# =============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Required for setup_inbound.py. Copy this from LiveKit Cloud Settings > Project.
# It is NOT the project URL subdomain. Do not include the sip: prefix.
# Example: your-sip-subdomain.sip.livekit.cloud
LIVEKIT_SIP_URI=

# =============================================================================
# Groq (required by the default LLM; also optional STT/TTS)
# Create a key at https://console.groq.com/keys
# The default model is available on Groq's free tier with daily token limits.
# =============================================================================
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.4
LLM_MAX_COMPLETION_TOKENS=200

# =============================================================================
# Speech recognition and synthesis
# Deepgram is the default because it streams audio and includes a one-time
# $200 credit. Groq Whisper is batch-only and adds latency; Groq Orpheus TTS is
# a low-quota preview. Read README.md before changing these providers.
# =============================================================================
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key
STT_MODEL=nova-3
STT_LANGUAGE=multi

TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# Optional non-default provider settings
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# =============================================================================
# Agent identity
# AGENT_NAME is the LiveKit dispatch name. It must match the dispatch rule
# created by setup_inbound.py.
# =============================================================================
AGENT_NAME=receptionist
BUSINESS_NAME=
AGENT_DISPLAY_NAME=AI receptionist
# Default reply language. Use a custom GREETING for non-English first lines.
AGENT_LANGUAGE=en-IN
# Leave blank to use the generated greeting. Keep it short for a phone call.
GREETING=
# Optional full override. Leave blank to use the built-in receptionist prompt.
SYSTEM_PROMPT=

# =============================================================================
# Call lifecycle and privacy
# Recordings and transcripts are never stored by this project.
# =============================================================================
MAX_CALL_DURATION_SECONDS=600
END_CALL_GRACE_SECONDS=6
CALL_SUMMARY_ENABLED=false
CALL_SUMMARY_MODEL=
CALL_SUMMARY_TIMEOUT_SECONDS=8
STORE_CALLER_NUMBER=false
DATABASE_PATH=data/calls.db

# Optional Cloudflare Worker call-event delivery.
# The token must be at least 16 characters and must match the Worker secret.
CALL_EVENT_WEBHOOK_URL=
CALL_EVENT_WEBHOOK_TOKEN=
CALL_EVENT_TIMEOUT_SECONDS=5

# =============================================================================
# Telephony: Vobiz inbound (required for setup, not for every agent restart)
# Use the full E.164 number linked to your Vobiz SIP trunk.
# =============================================================================
VOBIZ_INBOUND_NUMBER=+91XXXXXXXXXX
# Leave empty to accept SIP traffic from any source. Restrict this in production.
INBOUND_SIP_ALLOWED_ADDRESSES=
# Optional digest authentication for the LiveKit inbound trunk.
INBOUND_SIP_AUTH_USERNAME=
INBOUND_SIP_AUTH_PASSWORD=
ROOM_PREFIX=call-

# =============================================================================
# Optional outbound calling (the existing dashboard and make_call.py)
# Inbound answering does not use these credentials.
# =============================================================================
OUTBOUND_TRUNK_ID=
VOBIZ_SIP_TRUNK_ID=
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=
ENABLE_TRANSFER=false
DEFAULT_TRANSFER_NUMBER=

# =============================================================================
# Runtime
# =============================================================================
NOISE_CANCELLATION=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Next.js outbound dashboard only (optional)
# The proxy fails closed when these are empty. Use long, unique values.
# =============================================================================
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
